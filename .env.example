# =============================================================
#  JU Web Dev AI — environment template
#  Copy to .env for local development:  cp .env.example .env
#  Never commit real keys. .env is git-ignored.
# =============================================================

# Database (exp5–exp8). Blank = bundled in-memory MongoDB.
MONGODB_URI=

# exp6 JWT signing secret.
JWT_SECRET=change-me-to-a-long-random-string

# Generative AI (exp9–exp12). Blank keys = demo mode.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
# Gemini 4 models always think; thinking tokens count towards the output
# budget. "low" is the right setting for chat/content demos.
GEMINI_THINKING_LEVEL=low
# Comma-separated models tried when the primary is 429/503.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite

# Local API ports (optional). Keep in sync with lib/api.ts.
EXP5_PORT=4005
EXP6_PORT=4006
EXP7_PORT=4007
EXP8_PORT=4008
EXP9_PORT=4009
EXP10_PORT=4010
EXP11_PORT=4011
EXP12_PORT=4012
# Port used by the single-service API gateway (npm run server:gateway).
GATEWAY_PORT=4100

# Production API origins for the Vercel front end (exp13).
# Leave these commented locally; set them in the Vercel dashboard.
# NEXT_PUBLIC_API_EXP5=https://your-exp5-api.onrender.com
# NEXT_PUBLIC_API_EXP6=https://your-exp6-api.onrender.com
# NEXT_PUBLIC_API_EXP7=https://your-exp7-api.onrender.com
# NEXT_PUBLIC_API_EXP8=https://your-exp8-api.onrender.com
# NEXT_PUBLIC_API_EXP9=https://your-exp9-api.onrender.com
# NEXT_PUBLIC_API_EXP10=https://your-exp10-api.onrender.com
# NEXT_PUBLIC_API_EXP11=https://your-exp11-api.onrender.com
# NEXT_PUBLIC_API_EXP12=https://your-exp12-api.onrender.com
